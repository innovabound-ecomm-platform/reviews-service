  "devDependencies": {
    "@innovabound-ecomm-platform/eslint-config": "workspace:*",
    "@innovabound-ecomm-platform/typescript-config": "workspace:*",
    "@types/cookie-parser": "^1.4.8",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.3",
    "@types/node": "^22.15.21",
    "@types/swagger-jsdoc": "^6.0.4",
    "@types/swagger-ui-express": "^4.1.7",
